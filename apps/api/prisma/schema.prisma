// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  auditLogs     AuditLog[]
  notifications Notification[]
  calculationHistories CalculationHistory[]
  fgStocks      FGStock[]
  wips          WIP[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// ============================================
// MASTER DATA
// ============================================

model Item {
  id        String   @id @default(cuid())
  partNumber  String   @unique
  itemName  String
  unit      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  dailySchedules  DailySchedule[]
  weeklySchedules WeeklySchedule[]
  fgStocks        FGStock[]
  wips            WIP[]
  masterCartons   MasterCarton[]

  @@index([partNumber])
  @@index([itemName])
  @@map("items")
}

model MasterCarton {
  id             String   @id @default(cuid())
  cartonCode     String   @unique
  toyNameItemId  String // Reference to Item (Toy Name)
  partNumberCode String // Part number that belongs to this master carton
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  toyNameItem Item @relation(fields: [toyNameItemId], references: [id], onDelete: Cascade)

  @@index([toyNameItemId])
  @@index([partNumberCode])
  @@map("master_cartons")
}

// ============================================
// DEMAND / SCHEDULE
// ============================================

model DailySchedule {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  shift     Int // 1, 2, or 3
  itemId    String
  quantity  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([date, shift, itemId])
  @@index([date, shift])
  @@index([itemId])
  @@map("daily_schedules")
}

model WeeklySchedule {
  id            String   @id @default(cuid())
  year          Int
  weekNumber    Int // 1-26
  weekStartDate DateTime @db.Date
  weekEndDate   DateTime @db.Date
  itemId        String
  quantity      Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([year, weekNumber, itemId])
  @@index([year, weekNumber])
  @@index([itemId])
  @@map("weekly_schedules")
}

// ============================================
// STOCK & INVENTORY
// ============================================

model FGStock {
  id        String    @id @default(cuid())
  itemId    String    @unique // Unique karena hanya 1 record per item (overwrite)
  quantity  Float
  date      DateTime  @db.Date
  shift     Int? // Optional
  notes     String?   @db.Text
  updatedBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [updatedBy], references: [id])

  @@index([itemId])
  @@index([date])
  @@map("fg_stocks")
}

// ============================================
// WORK IN PROGRESS (WIP)
// ============================================

enum WIPStatus {
  IN_PROGRESS
  ON_HOLD
  DELAYED
  COMPLETED
}

model WIP {
  id              String    @id @default(cuid())
  itemId          String
  location        String // Mesin-01, Assembly Line, etc.
  quantity        Float
  progressPercent Int       @default(0) // 0-100
  date            DateTime  @db.Date
  shift           Int // 1, 2, or 3
  status          WIPStatus @default(IN_PROGRESS)
  notes           String?   @db.Text
  updatedBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [updatedBy], references: [id])

  @@unique([itemId, location]) // Unique per item + location (overwrite)
  @@index([itemId])
  @@index([location])
  @@index([status])
  @@index([date, shift])
  @@map("wips")
}

// ============================================
// AUDIT LOG
// ============================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  action     AuditAction
  entityType String // "FGStock", "WIP", "DailySchedule", etc.
  entityId   String
  dataBefore Json? // Data sebelum perubahan
  dataAfter  Json? // Data setelah perubahan
  notes      String?     @db.Text
  createdAt  DateTime    @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  SHORTAGE
  DELAY
  STALE_DATA
  INFO
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  itemCode  String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// HOTLIST
// ============================================

model Hotlist {
  id           String    @id @default(cuid())
  partNumber   String    @unique
  date         DateTime  @db.Date
  previousDate DateTime? @db.Date
  biTotal      Float
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([partNumber])
  @@index([date])
  @@map("hotlists")
}

// ============================================
// STOCK RAW MATERIAL
// ============================================

model StockRawMaterial {
  id        String   @id @default(cuid())
  itemDesc  String
  date      DateTime @db.Date
  supplier  String?
  qty       Float
  unit      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("stock_raw_materials")
}

// ============================================
// OUTSTANDING PO
// ============================================

model OutstandingPO {
  id               String   @id @default(cuid())
  planReceivedDate DateTime @db.Date
  supplierName     String
  itemDesc         String
  qtyOrder         Float
  qtyOrderUnit     String   // "kg", "rim", "sheets"
  qtyDelivered     Float
  qtyDeliveredUnit String   // "kg", "rim", "sheets"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([planReceivedDate])
  @@map("outstanding_pos")
}

// ============================================
// NPOF MATERIALS
// ============================================

model NpofMaterial {
  id              String    @id @default(cuid())
  npofId          Int
  partNumber      String
  productName     String
  material        String?
  gramatur        String?
  supplier        String?
  sheetedSize     String?
  formulaMaterial String?   @db.Text
  ups             String?
  isEdited        Boolean   @default(false)
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([npofId, partNumber])
  @@index([npofId])
  @@index([partNumber])
  @@map("npof_materials")
}

// Immutable monthly snapshots of material calculations and their source data.
model CalculationHistory {
  id             String   @id @default(cuid())
  monthKey       String   // YYYY-MM folder key
  periodStartDate DateTime @db.Date
  periodEndDate   DateTime @db.Date
  periodWeeks     Int
  calculatedAt    DateTime
  savedAt         DateTime @default(now())
  savedBy         String
  resultSnapshot  Json

  user    User @relation(fields: [savedBy], references: [id])
  sources CalculationSourceSnapshot[]

  @@index([monthKey])
  @@index([savedAt])
  @@map("calculation_histories")
}

model CalculationSourceSnapshot {
  id          String   @id @default(cuid())
  historyId   String
  sourceType  String   // MRP, NPOF, StockRawMaterial, WIP, HOTLIST, OutstandingPO
  dataSnapshot Json
  createdAt   DateTime @default(now())

  history CalculationHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)

  @@unique([historyId, sourceType])
  @@index([sourceType])
  @@map("calculation_source_snapshots")
}
